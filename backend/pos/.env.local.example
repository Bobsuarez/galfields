# Env vars to run backend/pos locally against compose.yaml's Postgres+MinIO.
# Copy to .env.local (gitignored) or just `export` these in your shell —
# Spring Boot doesn't auto-load .env files, this is just for your reference/
# a `source`-able script, not consumed directly by the app.

export DB_URL_PRIMARY=jdbc:postgresql://localhost:5433/pos
export DB_USER_PRIMARY=postgres
export DB_PASSWORD_PRIMARY=postgres
export DB_URL_REPLICA=jdbc:postgresql://localhost:5433/pos
export DB_USER_REPLICA=postgres
export DB_PASSWORD_REPLICA=postgres

export MINIO_ENDPOINT=http://localhost:9000
export MINIO_ACCESS_KEY=minioadmin
export MINIO_SECRET_KEY=minioadmin
export MINIO_BUCKET=galfields-products

# HS256 needs >= 256 bits — generate a real one per environment, this is just
# a throwaway for local dev.
export JWT_SECRET=$(openssl rand -base64 32)

export SERVER_PORT=8080
