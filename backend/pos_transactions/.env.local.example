# Env vars to run pos_transactions locally against compose.yaml's Postgres+MinIO
# (its own dev copy, separate from backend/pos's — see compose.yaml's comment).
# Spring Boot doesn't auto-load .env files: copy to .env.local (gitignored)
# or `source` this directly.

export DB_URL_PRIMARY=jdbc:postgresql://localhost:5434/pos_transactions
export DB_USER_PRIMARY=postgres
export DB_PASSWORD_PRIMARY=postgres
export DB_URL_REPLICA=jdbc:postgresql://localhost:5434/pos_transactions
export DB_USER_REPLICA=postgres
export DB_PASSWORD_REPLICA=postgres

export MINIO_ENDPOINT=http://localhost:9002
export MINIO_ACCESS_KEY=minioadmin
export MINIO_SECRET_KEY=minioadmin
export MINIO_BUCKET=galfields-products

# HS256 needs >= 256 bits — generate a real one per environment, this is
# just a throwaway for local dev.
export JWT_SECRET=$(openssl rand -base64 32)

# Different from backend/pos's default (8080) so both can run at once locally.
export SERVER_PORT=8081
